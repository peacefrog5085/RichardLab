    {"id": "github", "purpose": "unverified GitHub mutations; unavailable without a separate approval and credential change", "enabled": false, "connection_status": "unverified", "access": "write", "writes_require_approval": true, "capabilities": ["repository.write", "issues.write", "pull_requests.write"]},
    {"id": "supabase", "purpose": "structured records and durable application data", "capabilities": ["database.read", "database.write"]},
